# ============================================================
# 承脉 AI 环境变量模板
# 使用方法：复制本文件为 .env，然后填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，真实密钥永远不会上传 GitHub
# ============================================================

# ---------- 大模型（成员 A 负责） ----------

# Qwen3 接入方式：api = 阿里云百炼 DashScope API（推荐，零成本起步）
LLM_PROVIDER=api

# DashScope 的 OpenAI 兼容接口地址（Qwen3 官方支持 OpenAI 协议）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 你的 API Key，去 https://bailian.console.aliyun.com/ 获取（sk- 开头）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 对话模型（根据百炼控制台可用列表调整）
LLM_MODEL=qwen-plus

# Embedding 向量化模型（RAG 检索用）
EMBEDDING_MODEL=text-embedding-v3

# ---------- 数据库（成员 C 负责） ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chengmai

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
